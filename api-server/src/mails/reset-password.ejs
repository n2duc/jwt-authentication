<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <style type="text/css">
    @import url('https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap');
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      min-width: 100%;
      font-family: Roboto, sans-serif;
      font-size: 16px;
      line-height: 1.5;
      background-color: #FAFAFA;
    }

    a {
      color: #FFFFFF;
      text-decoration: none;
      font-size: 16px;
    }

    .email_wrapper {
      max-width: 665px;
      margin: 0 auto;
      border: 1px solid #BBCADE;
      border-radius: 12px;
    }
    .email_header {
      width: 100%;
      margin: 0 auto;
      padding: 26px 0;
      text-align: center;
      border-bottom: 1px solid rgba(232, 230, 246, 0.84);
    }
    .email_header h2 {
      color: #02072C;
      font-size: 20px;
      font-weight: 500;
      letter-spacing: 3.1px;
    }
    .email_header h1 {
      color: #02072C;
      font-size: 24px;
      font-style: normal;
      font-weight: 600;
    }
    .email_content {
      width: 100%;
      padding: 30px 52px;
      padding-bottom: 40px;
    }
    .email_name {
      font-size: 16px;
      font-weight: 600;
      color: #02072C;
      margin-bottom: 20px;
    }
    .email_desc {
      font-size: 16px;
      font-weight: 400;
      color: #02072C;
      margin-bottom: 20px;
    }
    .reset_button {
      display: block;
      width: 100%;
      padding: 18px;
      font-weight: 600;
      background: #3177FF;
      border-radius: 10px;
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="email_wrapper">
    <div class="email_header">
      <h2>N2Dev HUB</h2>
      <h1>Reset your password</h1>
    </div>
    <div class="email_content" style="flex-direction: column;">
      <p class="email_name">Hey, <%= username %>,</p>
      <p class="email_desc">Need to reset your password? No problem! Just click the button below and you’ll be on your way. If you did not make this request, please ignore this email</p>

      <a href="<%= resetURL %>" class="reset_button" style="color: white;">Reset your password</a>
    </div>
  </div>
</body>
</html>